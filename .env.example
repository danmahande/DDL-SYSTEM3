# Security
SESSION_SECRET=replace-with-a-long-random-secret
ALLOW_PUBLIC_REGISTRATION=false
RETAILER_API_KEY=replace-with-retailer-ingestion-key

# CORS (comma-separated origins; leave empty for dev wildcard)
ALLOWED_ORIGINS=http://localhost:3000

# Client-side registration toggle (must match ALLOW_PUBLIC_REGISTRATION)
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=false

# Mapbox Configuration - Get your token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Upstash Redis (for real-time signals)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ddl_system3?schema=public"
